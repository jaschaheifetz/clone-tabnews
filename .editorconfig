root = true # Indica que este é o arquivo raiz do EditorConfig

# EditorConfig é uma ferramenta para manter estilos de codificação consistentes entre diferentes editores e IDEs. 
# Este arquivo define regras de formatação para todos os arquivos no projeto.
[*] # Identação funciona para todos os arquivos
indent_style = space # Estilo de indentação é com espaços
indent_size = 4 # Tamanho da indentação é de 4 espaços